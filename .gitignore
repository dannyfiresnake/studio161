/node_modules

# Vite build output (generated from ui/ into static/ by `npm run build`)
/static/index.html
/static/assets

# Rust build output
/target

# Secrets — the cloud sign-in pair used by dev.sh, and the Android signing
# passwords. Tauri's generated gen/android/.gitignore covers key.properties
# but NOT keystore.properties, so it is listed explicitly here.
/worker/.credentials
/gen/android/app/keystore.properties

# Local tool state
/.wrangler
/worker/.wrangler
/.playwright-mcp
.DS_Store

# Generated by tauri-build on every build
/gen/schemas

# The built frontend, staged into the APK by `tauri android build`; it is a
# copy of static/, which is itself ignored above.
/gen/android/app/src/main/assets/static
